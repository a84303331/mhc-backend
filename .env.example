# MHC Backend 環境變數（複製此檔為 .env 並填入實際值）
# 安全準則：.env 絕不 commit 到 GitHub

# LLM API
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# MHC Backend API 驗證（Railway → PC 的內部 API key）
MHC_API_TOKEN=generate-a-random-token-here

# Obsidian Vault 路徑
OBSIDIAN_VAULT_PATH=/mnt/d/Obsidian/Doc_Obsidian/Summer_sync

# Server
HOST=0.0.0.0
PORT=8001
